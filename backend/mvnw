#!/bin/sh
set -eu

MAVEN_VERSION="3.9.9"
DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip"
WRAPPER_BASE="${MAVEN_USER_HOME:-$HOME/.m2}/wrapper/dists"
DIST_DIR="${WRAPPER_BASE}/apache-maven-${MAVEN_VERSION}-bin"
MVN_BIN="${DIST_DIR}/apache-maven-${MAVEN_VERSION}/bin/mvn"

if [ ! -x "${MVN_BIN}" ]; then
  echo "[mvnw] Downloading Apache Maven ${MAVEN_VERSION}..."
  mkdir -p "${DIST_DIR}"
  ZIP_FILE="${DIST_DIR}/apache-maven-${MAVEN_VERSION}-bin.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "${ZIP_FILE}" "${DIST_URL}"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "${ZIP_FILE}" "${DIST_URL}"
  else
    echo "[mvnw] ERROR: curl or wget is required to download Maven." >&2
    exit 1
  fi
  unzip -q -o "${ZIP_FILE}" -d "${DIST_DIR}"
  rm -f "${ZIP_FILE}"
  chmod +x "${MVN_BIN}"
fi

exec "${MVN_BIN}" "$@"
